# Required: Vivino username
VIVINO_USERNAME=your_username

# Optional: Pre-resolved numeric user ID (skips HTML scrape)
# Find it in Chrome DevTools > Network tab on vivino.com/en/users/your_username
# Look for any XHR request to /api/users/{number}/...
VIVINO_USER_ID=

# Optional: Session cookie for private data (cellar, wishlist)
# Copy from Chrome DevTools > Application > Cookies > vivino.com
# Format: "_session_id=abc123; other_cookie=val"
VIVINO_SESSION_COOKIE=

# Optional: Path to your Obsidian vault's Wine knowledge base
# Used by vivino_sync_to_obsidian to export ratings as markdown notes
OBSIDIAN_VAULT_PATH=/path/to/Obsidian Vault/Knowledge/Wine

# Optional: Exa API key for enriching wine data with web research
# Leave blank to skip Exa enrichment in sync
EXA_API_KEY=
